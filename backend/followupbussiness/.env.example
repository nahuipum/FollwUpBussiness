# SMTP stays off until valid Gmail app-password credentials are available.
FOLLOWUPBUSSINESS_EMAIL_ENABLED=false
FOLLOWUPBUSSINESS_EMAIL_FROM=your-address@gmail.com
FOLLOWUPBUSSINESS_EMAIL_ACTIVATION_URL=http://localhost:5173/password-reset

SPRING_MAIL_HOST=smtp.gmail.com
SPRING_MAIL_PORT=587
SPRING_MAIL_USERNAME=your-address@gmail.com
SPRING_MAIL_PASSWORD=google-app-password
SPRING_MAIL_PROPERTIES_MAIL_SMTP_AUTH=true
SPRING_MAIL_PROPERTIES_MAIL_SMTP_STARTTLS_ENABLE=true
