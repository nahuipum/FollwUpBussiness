# FollowUpBussiness local development only.
# These public placeholder credentials are NOT suitable for production.
# Copy this file to .env and replace the passwords with local-only values.

# Backend security baseline. The application rejects this documented placeholder.
FOLLOW_UP_BUSSINESS_SECURITY_LOCAL_SECRET=replace_with_32_plus_random_local_characters

# Authentication signing material for local development. Keep real values only
# in ignored local environment files or process variables.
AUTH_RS256_PRIVATE_KEY=change_me_local_only
AUTH_HMAC_SECRET=replace_with_32_plus_random_local_characters
AUTH_KID=local-rs256-v1
AUTH_ISSUER=https://localhost:8080
AUTH_AUDIENCE=followupbussiness-local-web
AUTH_WEB_ORIGIN=http://localhost:5173

# TLS is optional on loopback. Enable these only when testing local HTTPS.
SERVER_SSL_ENABLED=false
# For HTTPS, provide SERVER_SSL_KEY_STORE, SERVER_SSL_KEY_STORE_PASSWORD and
# SERVER_SSL_KEY_ALIAS only in your ignored local .env file.

# EN-012 one-shot bootstrap. Keep all values empty in this public template.
FOLLOW_UP_BUSSINESS_BOOTSTRAP_SUPERADMIN_IDENTITY=
FOLLOW_UP_BUSSINESS_BOOTSTRAP_SUPERADMIN_PASSWORD=
FOLLOW_UP_BUSSINESS_BOOTSTRAP_SUPERADMIN_DISPLAY_NAME=
FOLLOW_UP_BUSSINESS_BOOTSTRAP_SUPERADMIN_EMAIL=

POSTGRES_DB=followupbussiness
POSTGRES_USER=followupbussiness_local
POSTGRES_PASSWORD=change_me_local_only
POSTGRES_PORT=5432

# Local least-privilege audit identities. Use distinct, random values.
AUDIT_WRITER_PASSWORD=change_me_local_only
AUDIT_PURGER_PASSWORD=change_me_local_only
# For Maven execution outside Docker, these URLs target the local published port.
AUDIT_WRITER_URL=jdbc:postgresql://localhost:5432/followupbussiness?ApplicationName=followupbussiness-audit-writer
AUDIT_WRITER_USERNAME=audit_writer_local
AUDIT_PURGER_URL=jdbc:postgresql://localhost:5432/followupbussiness?ApplicationName=followupbussiness-audit-purger
AUDIT_PURGER_USERNAME=audit_purger_local

REDIS_PASSWORD=change_me_local_only
REDIS_PORT=6379

RABBITMQ_USER=followupbussiness_local
RABBITMQ_PASSWORD=change_me_local_only
RABBITMQ_VHOST=followupbussiness
RABBITMQ_AMQP_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672
