# FieldSales CRM local development only.
# These public placeholder credentials are NOT suitable for production.
# Copy this file to .env and replace the passwords with local-only values.

# Backend security baseline. The application rejects this documented placeholder.
FIELD_SALES_SECURITY_LOCAL_SECRET=replace_with_32_plus_random_local_characters

# EN-012 one-shot bootstrap. Keep all values empty in this public template.
FIELD_SALES_BOOTSTRAP_SUPERADMIN_IDENTITY=
FIELD_SALES_BOOTSTRAP_SUPERADMIN_PASSWORD=
FIELD_SALES_BOOTSTRAP_SUPERADMIN_DISPLAY_NAME=
FIELD_SALES_BOOTSTRAP_SUPERADMIN_EMAIL=

POSTGRES_DB=fieldsales
POSTGRES_USER=fieldsales_local
POSTGRES_PASSWORD=change_me_local_only
POSTGRES_PORT=5432

REDIS_PASSWORD=change_me_local_only
REDIS_PORT=6379

RABBITMQ_USER=fieldsales_local
RABBITMQ_PASSWORD=change_me_local_only
RABBITMQ_VHOST=fieldsales
RABBITMQ_AMQP_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672
