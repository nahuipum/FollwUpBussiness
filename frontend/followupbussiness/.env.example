# URL absoluta del backend local TLS que expone el contrato OpenAPI. No incluir secretos.
VITE_API_BASE_URL=https://localhost:8080

# Rutas fuera del repositorio a un certificado de desarrollo confiable para Vite.
# No tienen prefijo VITE_ porque no se exponen al navegador.
# FRONTEND_HTTPS_CERT=C:/Users/you/.followupbussiness/localhost.pem
# FRONTEND_HTTPS_KEY=C:/Users/you/.followupbussiness/localhost-key.pem
