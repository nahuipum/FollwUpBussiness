# En desarrollo, las solicitudes usan el namespace /api; Vite solo reenvía
# /api/* a este destino y elimina el prefijo antes de llegar al Backend.
# VITE_API_BASE_URL no se utiliza en desarrollo.
VITE_DEV_API_PROXY_TARGET=http://localhost:8080

# En producción configure una URL HTTPS absoluta del Backend; las rutas
# contractuales se conservan sin el prefijo /api.
# VITE_API_BASE_URL=https://api.example.com

# Token público restringido a tiles/origen/ambiente; no use claves server-side.
# VITE_GEOAPIFY_TILE_KEY=

# Opcional: rutas fuera del repositorio para servir Vite con HTTPS local.
# No tienen prefijo VITE_ porque no se exponen al navegador.
# FRONTEND_HTTPS_CERT=C:/Users/you/.followupbussiness/localhost.pem
# FRONTEND_HTTPS_KEY=C:/Users/you/.followupbussiness/localhost-key.pem
